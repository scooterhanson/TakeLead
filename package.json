{
  "name": "takelead",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Karaoke party app: hosts build a playlist, guests join by QR code and queue up, a Now Playing screen runs the show.",
  "license": "AGPL-3.0-or-later",
  "author": "Scooter Hanson",
  "repository": {
    "type": "git",
    "url": "https://github.com/scooterhanson/TakeLead.git"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "demo-songs": "tsx scripts/make-demo-songs.ts",
    "backup": "tsx scripts/backup.ts",
    "package": "bash scripts/package.sh"
  },
  "dependencies": {
    "express": "^5.3.0",
    "nodemailer": "^10.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.13"
  }
}
