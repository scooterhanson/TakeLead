# TakeLead settings. Copy this file to .env and fill it in.

NODE_ENV=production

# Port the app listens on. Cloudflare Tunnel points at http://localhost:PORT
PORT=3000
# 0.0.0.0 = also reachable on your home network (guests on your Wi-Fi can use it directly).
# 127.0.0.1 = only reachable through the tunnel.
HOST=0.0.0.0

# The public address of the site. Used for QR codes and links in emails.
PUBLIC_URL=https://karaoke.example.com

# Where the database, guest photos and your own song files live.
DATA_DIR=./data
MEDIA_DIR=./media

# Accounts
# Set to false once you've made your own account, to stop strangers from signing up.
ALLOW_REGISTRATION=true
# Set to true to require a signed-in account to create a party.
REQUIRE_ACCOUNT_TO_HOST=false

# Email for password resets. A mailbox from your HostGator account works:
# create one in cPanel > Email Accounts, then use these settings.
# Leave SMTP_HOST empty to print reset links in the server log instead.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=
MAIL_FROM=TakeLead <noreply@example.com>
